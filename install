nohup python3 /home/mdm/ai-server/n8n_data/soti_export_service.py > /home/mdm/soti_service.log 2>&1 &

sudo nano /etc/systemd/system/soti-export.service
[Unit]
Description=SOTI Export JSON Service
After=network.target

[Service]
User=mdm
WorkingDirectory=/home/mdm/ai-server/n8n_data
ExecStart=/usr/bin/python3 /home/mdm/ai-server/n8n_data/soti_export_service.py
Restart=always

[Install]
WantedBy=multi-user.target

sudo systemctl daemon-reload
sudo systemctl enable --now soti-export
sudo systemctl status soti-export
