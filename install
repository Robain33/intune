cd ~ && tar xzf soti-mcp-deploy.tar.gz && cd soti-mcp && ls -la


./bootstrap.sh

./close-c1-c2.sh inventory


./close-c1-c2.sh stop --confirm

./close-c1-c2.sh up


./close-c1-c2.sh verify


docker pull python:3.12-slim && docker inspect --format='{{index .RepoDigests 0}}' python:3.12-slim


sudo usermod -aG docker $USER


sudo apt install docker-compose-plugin



cd ~/soti-mcp && sed -i 's|^\( *\)if \[ ! -f "\$SECRET_FILE" \]; then|\1if ! sudo test -f "$SECRET_FILE"; then|' close-c1-c2.sh && grep -c 'sudo test -f' close-c1-c2.sh

sudo cp ~/etc/soti-agent/zetesdemo.secret /etc/soti-agent/zetesdemo.secret && sudo sed -i 's/\r$//' /etc/soti-agent/zetesdemo.secret && sudo chmod 600 /etc/soti-agent/zetesdemo.secret

sudo sh -c 'n=0; for k in SOTI_CLIENT_ID SOTI_CLIENT_SECRET SOTI_USERNAME SOTI_PASSWORD; do v=$(grep -E "^$k=" /etc/soti-agent/zetesdemo.secret | head -n1 | cut -d= -f2-); [ -n "$v" ] && { echo "  $k OK (${#v} chars)"; n=$((n+1)); } || echo "  $k EMPTY"; done; echo "  $n/4 ready"'

./close-c1-c2.sh up && ./close-c1-c2.sh verify
