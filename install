docker ps --filter label=com.docker.compose.project=soti-zetesdemo --format 'table {{.Names}}\t{{.Status}}'; echo "--- logs ---"; docker logs zetesdemo-mcp --tail 20; echo "--- host 8080 (want nothing) ---"; ss -ltn | grep ':8080' || echo "  nothing published - correct"; echo "--- MCP inside container ---"; docker exec zetesdemo-mcp python -c "
import json,urllib.request
b=json.dumps({'jsonrpc':'2.0','id':1,'method':'initialize','params':{'protocolVersion':'2024-11-05','capabilities':{},'clientInfo':{'name':'v','version':'1'}}}).encode()
r=urllib.request.Request('http://127.0.0.1:8080/mcp',data=b,method='POST')
r.add_header('Content-Type','application/json'); r.add_header('Accept','application/json, text/event-stream')
print(urllib.request.urlopen(r,timeout=10).read().decode()[:220])"
